# Copy this file to `.env` and fill in your own values. `.env` is gitignored -
# never commit real secrets. See README.md for full setup instructions.

# Must match the backend's GOOGLE_CLIENT_ID (ShopKart/.env). Google Sign-In
# renders a "not configured" message until this is set.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# The Razorpay *key id* (safe to expose client-side) - must be from the same
# Razorpay account as the backend's RAZORPAY_KEY_ID/RAZORPAY_KEY_SECRET
# (ShopKart/.env), or checkout will fail. Checkout is skipped without it.
VITE_RAZORPAY_KEY_ID=your-razorpay-test-key-id

# Only needed if the backend isn't reachable via the local Vite proxy default
# (http://localhost:9090) - e.g. pointing this build at a deployed backend.
# VITE_API_URL=http://localhost:9090
